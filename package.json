{
  "name": "annie",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.17.1",
  "dependencies": {
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest --run",
    "dev:telegram": "tsx src/main/telegram.ts",
    "dev:segreteria": "tsx src/main/segreteria.ts",
    "eval:segreteria": "tsx evals/segreteria/run.ts",
    "eval:segreteria:judge": "tsx evals/segreteria/judge.ts",
    "eval:segreteria:validate": "python3 evals/segreteria/scripts/validate_and_build.py"
  }
}
