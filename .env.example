# Copy to .env and fill in. .env is git-ignored.

# Required: token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Model provider: anthropic (default), openai, or faux (local deterministic model, no key, for development).
ANNIE_MODEL_PROVIDER=anthropic
# Default for anthropic: claude-sonnet-5-5. For faux: annie-dev.
ANNIE_MODEL_ID=claude-sonnet-5-5

# Required when ANNIE_MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Required when ANNIE_MODEL_PROVIDER=openai.
# OPENAI_API_KEY=

# Optional.
# ANNIE_DATA_DIR=data
# ANNIE_TENANT_ID=default
# ANNIE_INSTANCE_ID=telegram
