# Copy to .env and fill in. .env is git-ignored.
#
# pnpm start (or docker compose up -d) needs only the model key. Everything else is
# optional: Telegram, the segreteria. The first start prints the owner's login link.

# --- pnpm start: web console and general instance ---
# ANNIE_WEB_HOST=127.0.0.1        # 0.0.0.0 in Docker
# ANNIE_WEB_PORT=8080
# ANNIE_PUBLIC_URL=https://annie.example.it   # behind https: secure cookies and correct login links
# ANNIE_TIME_ZONE=Europe/Rome
# ANNIE_INSTANCE_ID=annie
# ANNIE_INSTANCE_NAME=Annie
# Telegram user IDs who approve the instance's tools proposti (cards with Approva/Rifiuta).
# ANNIE_TELEGRAM_APPROVERS=123456789
# Segreteria inside pnpm start: its own bot, the sales people, and the Gmail/HubSpot variables below.
# ANNIE_SEGRETERIA_TELEGRAM_BOT_TOKEN=
# ANNIE_SEGRETERIA_SALES=123456789,987654321

# Token from @BotFather. Required for dev:telegram and dev:segreteria; optional for pnpm start.
TELEGRAM_BOT_TOKEN=

# Model provider: anthropic (default), openai, or faux (local deterministic model, no key, for development).
ANNIE_MODEL_PROVIDER=anthropic
# Default for anthropic: claude-sonnet-5-5. For faux: annie-dev.
ANNIE_MODEL_ID=claude-sonnet-5-5

# Required when ANNIE_MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Required when ANNIE_MODEL_PROVIDER=openai.
# OPENAI_API_KEY=

# Optional.
# ANNIE_DATA_DIR=data
# ANNIE_TENANT_ID=default
# ANNIE_INSTANCE_ID=telegram   # dev:telegram default; pnpm start uses "annie"

# Telegram user IDs allowed to talk to the bot, comma-separated (default: nobody).
# Messages from anyone else are dropped without a reply and recorded in the tenant's audit log.
# ANNIE_TELEGRAM_ALLOWED_USERS=123456789,987654321

# --- Segreteria commerciale (pnpm dev:segreteria, or inside pnpm start) ---
# Use a different bot from dev:telegram: two processes polling one token steal each other's updates.
# TELEGRAM_BOT_TOKEN, ANTHROPIC_API_KEY and ANNIE_TELEGRAM_ALLOWED_USERS (the sales people) are required too.
# Each sales person must open the bot and press Start once, or Telegram will not let it write to them.
# anthropic (default: Haiku reads, Sonnet drafts) or faux (heuristics, no key).
# ANNIE_SEGRETERIA_MODEL=anthropic
# Gmail OAuth client (Google Cloud console) and a refresh token with scopes gmail.readonly + gmail.send.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# HubSpot private app token with scopes crm.objects.contacts.read and crm.objects.contacts.write.
HUBSPOT_ACCESS_TOKEN=
# Optional.
# ANNIE_SEGRETERIA_INSTANCE_ID=segreteria
# ANNIE_MAIL_POLL_SECONDS=60
# ANNIE_REQUIRE_VAT_NUMBER=false

# Optional: Telegram pushes updates to ANNIE_PUBLIC_URL/hooks/telegram/<instance> (https) instead of long polling.
# ANNIE_TELEGRAM_WEBHOOK_SECRET=

# Optional: people connect their own Google account from the console (read only).
# OAuth client of type "Web application"; redirect URI: ANNIE_PUBLIC_URL/oauth/google/callback.
# ANNIE_GOOGLE_CLIENT_ID=
# ANNIE_GOOGLE_CLIENT_SECRET=
# gmail,calendar (default) or one of them. gmail.readonly needs Google's yearly security assessment for a public app.
# ANNIE_GOOGLE_SERVICES=calendar

# Optional: Chromium for web_screenshot (Playwright's own browser if unset; the Docker image has it with WITH_BROWSER=1).
# ANNIE_CHROMIUM_PATH=/usr/bin/chromium
# Only if Chromium's sandbox cannot start here and you accept running it without (ADR 0009).
# ANNIE_SCREENSHOTS_WITHOUT_SANDBOX=1

# Voice messages (Telegram, WhatsApp) transcribed by an OpenAI-compatible service. Mistral (EU):
# ANNIE_TRANSCRIBE_URL=https://api.mistral.ai/v1
# ANNIE_TRANSCRIBE_API_KEY=
# ANNIE_TRANSCRIBE_MODEL=voxtral-mini-latest
# Longest voice message transcribed, 10 to 3600 seconds (Telegram only: WhatsApp does not say).
# ANNIE_TRANSCRIBE_MAX_SECONDS=300
# Each instance's owner then allows it in Settings → Messaggi vocali.

# Web search (Brave Search API, docs/chiavi.md §13). Each owner turns it on in Settings → Ricerca sul web.
# ANNIE_SEARCH_API_KEY=
# Only for a service with Brave's API at another address.
# ANNIE_SEARCH_URL=https://api.search.brave.com/res/v1/web/search
# Results from this country and in this language unless a search asks otherwise (IT and it by default).
# ANNIE_SEARCH_COUNTRY=IT
# ANNIE_SEARCH_LANG=it
# Searches per account per day, all its instances together (200 by default).
# ANNIE_SEARCH_MAX_PER_DAY=200

# Phone calls on a Twilio number (ADR 0012): connected per instance from the console, needs ANNIE_PUBLIC_URL in https.
# Twilio's REST API; for data in the EU use the Ireland region, https://api.dublin.ie1.twilio.com.
# ANNIE_TWILIO_API=https://api.twilio.com
# Twilio's voice for the spoken replies (everything is said in Italian).
# ANNIE_PHONE_VOICE=Polly.Bianca

# The instances' computers (ADR 0013, runbook 6j): a container each, with no network, on this Docker host.
# The Docker socket is root on this server: only where Annie is the only service. Never in Annie Cloud.
# Build the image first: docker build -f docker/computer.Dockerfile -t annie-computer:latest docker
# ANNIE_COMPUTER=docker
# ANNIE_COMPUTER_IMAGE=annie-computer:latest
# ANNIE_DOCKER_SOCKET=/var/run/docker.sock
# Per computer: memory (128 to 16384 MB), CPUs (0.25 to 16), quota of /work (64 to 102400 MB).
# ANNIE_COMPUTER_MEMORY_MB=1024
# ANNIE_COMPUTER_CPUS=1
# ANNIE_COMPUTER_DISK_MB=2048
# runsc for gVisor, a kernel of its own (installed and registered with Docker first).
# ANNIE_COMPUTER_RUNTIME=
# Each instance's owner then turns it on in Settings → Computer.

# --- Annie Cloud control plane (pnpm cloud) ---
# Sign-in links by email: any SMTP service. smtps://user:password@host:465, or smtp://...:587 with STARTTLS.
# Without it the links go to data-cloud/mail/outbox.txt.
# ANNIE_CLOUD_SMTP_URL=
# ANNIE_CLOUD_MAIL_FROM=Annie <accesso@example.it>
# Cells: local (processes, development), docker (one container per tenant, ADR 0008) or railway (runbook 6d).
# ANNIE_CLOUD_PROVIDER=docker
# ANNIE_CLOUD_DOCKER_IMAGE=annie:local
# ANNIE_CLOUD_CELL_MEMORY_MB=512
# RAILWAY_API_TOKEN=
# ANNIE_CLOUD_RAILWAY_IMAGE=ghcr.io/<owner>/annie:latest
# ANNIE_CLOUD_RAILWAY_WORKSPACE=
# ANNIE_CLOUD_RAILWAY_REGION=europe-west4-drams3a
# Subscriptions through Stripe (ADR 0010, runbook 6f). Without the key Annie Cloud is free to use.
# ANNIE_CLOUD_STRIPE_SECRET_KEY=
# ANNIE_CLOUD_STRIPE_WEBHOOK_SECRET=
# The flat monthly price; optionally a metered price on model cost (1 unit = 1 US cent at list prices) and its meter's event name.
# ANNIE_CLOUD_STRIPE_PRICE=
# ANNIE_CLOUD_STRIPE_USAGE_PRICE=
# ANNIE_CLOUD_STRIPE_METER_EVENT=annie_model_cost
# ANNIE_CLOUD_TRIAL_DAYS=14
